NODE_ENV=production
# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# The three values below initialize the PostgreSQL container on first start.
POSTGRES_DB=bluntforce
POSTGRES_USER=bluntforce_app
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://bluntforce_app:replace-with-a-long-random-password@postgres:5432/bluntforce

# Leave empty while accessing the site by IP. Set to https://your-domain.com later.
UPLOAD_PUBLIC_BASE_URL=
